{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hero-section",
  "type": "registry:block",
  "title": "Hero section",
  "description": "Three full screen SaaS heroes: a live dashboard rising from the bottom edge over a drifting mesh, a workflow graph that routes sample events node by node, and editorial type over a mesh gradient.",
  "categories": [
    "blocks"
  ],
  "dependencies": [
    "lucide-react",
    "motion"
  ],
  "registryDependencies": [
    "https://example.com/r/uikit-motion-tokens.json",
    "https://example.com/r/avatar.json",
    "https://example.com/r/button.json",
    "https://example.com/r/copy-button.json",
    "https://example.com/r/line-chart.json",
    "https://example.com/r/segmented-control.json",
    "https://example.com/r/sparkline.json"
  ],
  "files": [
