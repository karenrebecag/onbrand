# onbrand environment example. Copy to .env only what you want to change: the core starts with no variables at all.
# bun loads .env on its own. Every value here is the code's real default, so the example never promises other behavior.
# Profiles and precedence live in src/config.ts: the profile sets defaults and an explicit variable always wins.

# --- Core (clean clone: bun + the `claude` CLI, no accounts) ---

# core only. A distro variant loads via WT_PROFILE_MODULE (a path or package), never by name here:
# WT_PROFILE=<distro> fails at startup (src/config.ts).
WT_PROFILE=core

# LLM provider. cli uses the Claude Code session of whoever runs the server, so there is no key to configure.
WT_COMPOSE_PROVIDER=cli
WT_ENHANCER_PROVIDER=cli
# none in core: there is no image provider without an account, and --images does nothing.
WT_IMAGE_PROVIDER=none
# local exports the site to WT_PUBLISH_DIR (relative to the repo), with no account and no Vercel.
WT_PUBLISH_PROVIDER=local
# WT_PUBLISH_DIR=generated/v0-publish

# CLI binary and models. A full model id or an alias (sonnet | opus | haiku).
# WT_COMPOSE_CLI=claude
# WT_COMPOSE_MODEL=sonnet
# WT_AGENT_MODEL=
# WT_COPY_CLI=claude
# WT_COPY_MODEL=

# Ports and origins. The builder (vite) must match WT_BUILDER_ORIGIN, or every write gets a 403.
# WT_TRANSPORT_PORT=5300
# WT_PREVIEW_PORT=5301
# WT_PREVIEW_ORIGIN=http://localhost:5301
WT_BUILDER_ORIGIN=http://localhost:5173

# Brands. WT_BRAND_PACK sets the default pack for every run; without it, brands/brand-pack (neutral).
# WT_BRANDS_ROOT=./brands
# WT_BRAND_PACK=./brands/my-brand

# Concurrent runs across the whole process (positive integer).
# WT_MAX_RUNNING=3

# OTel traces: local Spotlight or an OTLP collector. With neither, the SDK is not even loaded.
# WT_SPOTLIGHT=1
# WT_SPOTLIGHT_URL=http://127.0.0.1:8969
# WT_OTLP_URL=

# Builder (apps/builder, read by vite). /api enables live mode; without it the builder replays a sample run.
# VITE_RUN_API=/api
# WT_TRANSPORT_URL=http://127.0.0.1:5300

# --- Distro profile (WT_PROFILE_MODULE). Details in docs/profile-module.md ---
# A distro (separate repo) adds its defaults and adapters with a module. Without this variable the core runs as is.

# WT_PROFILE_MODULE=/path/to/profile.ts
# Any of these overrides what the profile sets (they also work without a profile):
# WT_COMPOSE_PROVIDER=gateway
# WT_ENHANCER_PROVIDER=gateway
# WT_IMAGE_PROVIDER=gateway
# WT_PUBLISH_PROVIDER=local
# WT_BUILDER_ORIGIN=https://<deployed-builder>

# Orchestrator (bun scripts/orchestrator.ts; needs a profile with authenticate, sandbox and gateway).
# WT_ORCH_PRIVATE_KEY=
# WT_OWNER_CAP_USD=5
# WT_BLOB_PREFIX=wt/
# WT_BLOB_DIR=generated/orchestrator-blob
# PORT=5400

# AI Gateway (compose/enhancer/images with the gateway provider). In the deploy, Vercel's OIDC token is enough.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# WT_MODELS=anthropic/claude-opus-5.5,anthropic/claude-sonnet-5.5
# WT_IMAGE_MODELS=bfl/flux-3-image-klein

# Brand facts base URL (same as --facts); needs a profile that provides the facts port.
# WT_FACTS_URL=https://facts.example.com

# DS registry in the private Blob store (with --registry) and its publishing (build-registry --publish).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Local DS vault. Not needed in core: the DS mounts from registry/.
# WT_VAULT_ROOT=$HOME/Desktop/SoftwareDevProjects/Knowledge/Frontend/Components
# WT_BRANDS_ROOT=..

# Pipedream connectors. Without all four, /connectors/* answers 404.
# PIPEDREAM_CLIENT_ID=
# PIPEDREAM_CLIENT_SECRET=
# PIPEDREAM_PROJECT_ID=
# PIPEDREAM_ENVIRONMENT=

# Vercel Sandbox deploy. Off loopback, WT_ORIGIN_SECRET (32+ characters) is mandatory.
# WT_HOST=0.0.0.0
# WT_ORIGIN_SECRET=
# Identity under the orchestrator: the VM verifies the signed x-wt-identity header with the public key only (never the
# private one) and serves a single chat. Requires WT_SESSION_PROVIDER=signed, which exits 2 without both.
# WT_SESSION_PROVIDER=signed
# WT_IDENTITY_PUBLIC_KEY=
# WT_CHAT_ID=
# Preview token under the orchestrator (deploy-sandbox.md §4): the orchestrator signs it with the Ed25519 private key and
# the VM verifies with the public key only, so a compromised VM cannot mint previews. Asymmetric XOR WT_PREVIEW_SECRET
# (HMAC, local); setting both exits 2. With WT_SESSION_PROVIDER=signed the public key is mandatory. PEM, one line with \n.
# WT_PREVIEW_PRIVATE_KEY=
# WT_PREVIEW_PUBLIC_KEY=
# One published url per preview port, as sandbox.domain(port) returns it.
# WT_PREVIEW_URLS=5310=https://...,5311=https://...
# WT_RUNS_DISABLED=1
