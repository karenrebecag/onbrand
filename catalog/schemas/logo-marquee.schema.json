{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/logo-marquee.schema.json",
  "title": "Logo Marquee",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Section heading.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Supporting line under the heading.",
      "type": "string",
      "format": "description"
    },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "icon": {
            "x-undocumented": true,
            "type": "string",
            "format": "icon",
            "x-empty": ""
          },
          "color": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "colorIcon": {
            "x-undocumented": true,
            "type": "string",
            "format": "icon"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "icon"
        ]
      },
      "description": "Marks to show. Defaults to seven sample tool logos."
    },
    "tone": {
      "description": "Color shows each mark in its official brand colors; mono draws every mark in the text color for a quieter row.",
      "type": "string",
      "enum": [
        "color",
        "mono"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "brands"
  ]
}
