{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-morphing-navbar.schema.json",
  "title": "Animated Navbar Menu with Morphing Hover State",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "href": {
            "x-undocumented": true,
            "type": "string",
            "format": "link"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ]
      },
      "description": "Enlaces de la barra.",
      "maxItems": 4
    },
    "ariaLabel": {
      "description": "Nombre accesible del `<nav>`.",
      "type": "string",
      "format": "label"
    }
  },
  "x-formats-version": 2,
  "required": [
    "items",
    "ariaLabel"
  ],
  "examples": [
    {
      "items": [
        {
          "label": "Expertises",
          "href": "/"
        },
        {
          "label": "Work",
          "href": "/about"
        },
        {
          "label": "About",
          "href": "/about"
        },
        {
          "label": "Contact",
          "href": "/contact"
        }
      ],
      "ariaLabel": "Main"
    }
  ]
}
