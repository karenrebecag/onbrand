  "additionalProperties": false,
  "properties": {
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "format": {
            "x-undocumented": true,
            "type": "object"
          },
          "kind": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "total",
              "rate"
            ]
          },
          "lowerIsBetter": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "series": {
            "x-undocumented": true,
            "type": "array",
            "items": {
              "type": "number",
              "format": "series"
            }
          },
          "breakdowns": {
            "x-undocumented": true,
            "type": "object"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "format",
          "kind",
          "series",
          "breakdowns",
          "description"
        ]
      },
      "description": "Metrics: id, label, format, kind (total or rate), lowerIsBetter, daily series, breakdowns by dimension, and a description.",
      "maxItems": 6,
      "x-empty": "omit"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Breakdown dimensions; values match keys in each metric's breakdowns.",
      "maxItems": 3,
      "x-empty": "omit"
    },
    "end": {
      "description": "ISO date of the last value in every series.",
      "type": "string"
    },
    "defaultRange": {
      "description": "Initial range in days.",
      "type": "string",
      "enum": [
        "7",
        "30",
        "90"
      ]
    },
    "selected": {
      "x-nullable": true,
      "description": "Controlled open metric id, or null for the grid.",
      "type": "string"
    },
    "onSelectedChange": {
      "description": "Called when a metric opens or closes. Use it to keep the selection in the URL.",
      "type": "object"
    },
    "title": {
      "description": "Heading.",
      "type": "string",
      "format": "heading"
    }
  },
  "x-formats-version": 2,
  "required": [
    "kpis",
    "dimensions",
    "end"
  ],
