{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/testimonial-stage.schema.json",
  "title": "Testimonial Stage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Section heading.",
      "type": "string",
      "format": "heading"
    },
    "testimonials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "quote": {
            "x-undocumented": true,
            "type": "string",
            "format": "quote"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "role": {
            "x-undocumented": true,
            "type": "string",
            "format": "role"
          },
          "company": {
            "x-undocumented": true,
            "type": "string",
            "format": "company"
          },
          "photo": {
            "x-undocumented": true,
            "type": "object",
            "format": "image"
          }
        },
        "additionalProperties": false,
        "required": [
          "quote",
          "name",
          "role",
          "company"
        ]
      },
      "description": "Quotes with name, role, company and optional photo."
    },
    "labels": {
      "x-undocumented": true,
      "type": "object"
    },
    "onPerspectiveChange": {
      "description": "Called when the active person changes.",
      "type": "object"
    }
  },
  "x-formats-version": 2
}
