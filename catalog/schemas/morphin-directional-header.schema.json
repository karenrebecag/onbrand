{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-directional-header.schema.json",
  "title": "Directional Hover Header Navigation with Smart Dropdown Motion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Enlaces de primer nivel; los que traen `menu` abren el panel mega.",
      "maxItems": 4
    },
    "brandName": {
      "description": "Nombre de la marca: es siempre el nombre accesible del enlace; se pinta junto al logo salvo con `markIncludesName`.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "logo": {
      "description": "Logo de la marca, normalmente `<BrandMark />`; se pinta antes de `brandName`."
    },
    "markIncludesName": {
      "description": "El logo ya trae el nombre escrito (wordmark): el nombre no se repite a su lado. Con un símbolo solo, déjalo en false.",
      "type": "boolean"
    },
    "brandHref": {
      "type": "string",
      "x-format-confidence": "low"
    },
    "secondaryAction": {
      "x-nullable": true,
      "description": "Accion secundaria (contorno). `null` la oculta.",
      "type": "object",
      "format": "cta"
    },
    "primaryAction": {
      "x-nullable": true,
      "description": "Accion principal (rellena). `null` la oculta.",
      "type": "object",
      "format": "cta"
    },
    "labels": {
      "description": "Textos de interfaz; lo que no se pasa usa el default.",
      "type": "object"
    },
    "position": {
      "description": "`fixed` flota sobre la pagina; `sticky` y `static` ocupan su altura en flujo para no tapar la primera seccion.",
      "type": "string",
      "enum": [
        "fixed",
        "sticky",
        "static"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "items",
    "secondaryAction",
    "primaryAction"
  ],
  "examples": [
