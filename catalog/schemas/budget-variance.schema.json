{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/budget-variance.schema.json",
  "title": "Budget variance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "owner": {
            "x-undocumented": true,
            "type": "object"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "x-undocumented": true
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "owner",
          "lines"
        ]
      },
      "description": "Departments with an id, a name, an owner ({ name, avatar? }) and budget lines. Each line has an id, a name, and budget and actual amounts keyed by period id. Department figures and the total are summed from the lines.",
      "maxItems": 7,
      "x-empty": "omit"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "phrase": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "description",
          "phrase"
        ]
      },
      "description": "Reporting windows for the switch, each with an id, a short label, a description shown under the title and a phrase for screen reader sentences (\"in the third quarter\").",
      "maxItems": 3,
      "x-empty": "omit"
    },
    "defaultPeriod": {
      "description": "Id of the window shown first. Defaults to the first period.",
      "type": "string"
    },
    "defaultExpanded": {
      "x-nullable": true,
      "description": "Id of the department open on first render. Pass null to start with every department closed.",
      "type": "string"
    },
    "ranges": {
      "description": "Qualitative band edges as shares of budget. Spend between them is within tolerance; the bands step darker past the upper edge.",
      "type": "object"
    },
    "onPlanThreshold": {
      "description": "Variance smaller than this share of budget reads as on plan and stays neutral.",
      "type": "number"
    },
    "currency": {
      "description": "Symbol placed before every amount. Amounts shorten to k and M.",
      "type": "string"
    },
    "title": {
      "description": "Heading of the block.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Replaces the period description under the title.",
      "type": "string",
      "format": "description"
    },
    "onPeriodChange": {
      "description": "Called when the reporting window changes.",
      "type": "object"
    },
    "onDepartmentToggle": {
      "description": "Called when a department opens or closes. Opening one closes the one that was open, which is reported first.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "departments",
    "periods"
  ],
