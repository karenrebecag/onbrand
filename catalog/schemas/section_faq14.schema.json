{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/section_faq14.schema.json",
  "title": "FAQ 14",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "type": "string",
      "format": "heading"
    },
    "description": {
      "type": "string",
      "format": "description"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "x-undocumented": true,
            "type": "object",
            "format": "icon"
          },
          "question": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          },
          "answer": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          }
        },
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ]
      }
    },
    "footerHeading": {
      "type": "string",
      "format": "heading"
    },
    "footerDescription": {
      "type": "string",
      "x-format-confidence": "low"
    },
    "button": {
      "type": "object",
      "properties": {
        "variant": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "ghost",
            "danger",
            "whatsapp"
          ]
        },
        "size": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        "href": {
          "x-undocumented": true,
          "type": "string",
          "format": "link"
        },
        "title": {
          "x-undocumented": true,
          "type": "string",
          "format": "heading"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "heading",
    "description",
    "questions",
    "footerHeading",
    "footerDescription",
    "button"
  ]
}
