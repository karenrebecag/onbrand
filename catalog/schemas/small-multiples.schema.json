{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/small-multiples.schema.json",
  "title": "Small multiples",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "values": {
            "x-undocumented": true,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "values"
        ]
      },
      "description": "One panel per series: a stable id, a name for the panel heading and one value per period.",
      "maxItems": 8,
      "x-empty": "omit"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "short": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "long": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "short",
          "long"
        ]
      },
      "description": "Periods on the shared x axis, oldest first, each with a short label (\"Sep 2025\") and a long label (\"September 2025\") for the readout and screen readers.",
      "maxItems": 24,
      "x-empty": "omit"
    },
    "title": {
      "description": "Heading of the block.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Line under the title. Pass an empty string to hide it.",
      "type": "string",
      "format": "description"
    },
    "defaultSort": {
      "description": "Opening panel order.",
      "type": "string",
      "enum": [
        "latest",
        "growth",
        "name"
      ]
    },
    "defaultScale": {
      "description": "Opening y scale. Independent fits each series to its own range so panels compare shape; shared starts every panel at zero on one range so panels compare size.",
      "type": "string",
      "enum": [
        "shared",
        "independent"
      ]
    },
    "defaultDimFlat": {
      "description": "Whether panels with a flat trend start dimmed.",
      "type": "boolean"
    },
    "flatThreshold": {
      "description": "Growth below this absolute share counts as flat (0.05 is 5 percent).",
      "type": "number"
    },
    "growthLag": {
      "description": "Periods between the latest value and the value growth is measured against. 12 compares monthly data with the same month last year.",
      "type": "number"
    },
    "formatValue": {
      "description": "Formats values for panel headings, the readout and screen readers. The default reads values as thousands of US dollars ($412k, $1.71M).",
      "type": "object"
    },
    "formatTick": {
      "description": "Formats compact axis ticks in the right gutter of each panel.",
      "type": "object"
    },
    "onSortChange": {
      "description": "Called after the panel order changes.",
      "type": "object"
    },
    "onScaleChange": {
      "description": "Called after the y scale switches between independent and shared.",
      "type": "object"
    },
    "onIndexChange": {
      "description": "Called when the synced crosshair moves to a period, or with null when it leaves the panels.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "series",
    "periods",
    "title",
    "description"
  ],
