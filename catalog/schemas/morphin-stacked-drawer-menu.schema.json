{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-stacked-drawer-menu.schema.json",
  "title": "Stacked Drawer Navigation Menu in React, Tailwind and GSAP",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "navigation": {
      "description": "Arbol de navegacion: panel raiz, tarjeta promocional y enlaces secundarios.",
      "type": "object"
    },
    "brandName": {
      "description": "Texto de marca en el header.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "logo": {
      "description": "Logo propio; se pinta antes de `brandName`."
    },
    "brandHref": {
      "type": "string",
      "x-format-confidence": "low"
    },
    "labels": {
      "description": "Textos de interfaz; lo que no se pasa usa el default.",
      "type": "object"
    },
    "position": {
      "description": "`fixed` flota sobre la pagina; `sticky` y `static` ocupan su altura en flujo para no tapar la primera seccion.",
      "type": "string",
      "enum": [
        "fixed",
        "sticky",
        "static"
      ]
    },
    "children": {
      "description": "Contenido de la pagina; queda inerte mientras el drawer esta abierto."
    }
  },
  "x-formats-version": 2,
  "required": [
    "navigation"
  ],
