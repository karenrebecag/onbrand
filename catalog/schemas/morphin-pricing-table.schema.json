{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-pricing-table.schema.json",
  "title": "Shadcn Pricing Table for React & SaaS Apps",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Titular de la sección.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Texto de apoyo bajo el titular.",
      "type": "string",
      "format": "description"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Planes en orden de columna.",
      "maxItems": 3
    },
    "featureGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Matriz comparativa; cada fila trae un valor por plan. Con `plans` propios y sin esto no se pinta: la tabla de la demo mide 1179 px a 1440 y es contenido inventado (corrida c734443f).",
      "maxItems": 3
    },
    "billingLabels": {
      "description": "Textos del toggle de facturación.",
      "type": "object"
    },
    "currency": {
      "description": "Símbolo de moneda antepuesto al precio.",
      "type": "string"
    },
    "periodLabel": {
      "description": "Texto tras el precio, p. ej. \"per month\".",
      "type": "string",
      "format": "label"
    },
    "featuresLabel": {
      "description": "Cabecera de la columna de features.",
      "type": "string",
      "format": "label"
    },
    "defaultBilling": {
      "description": "Facturación inicial.",
      "type": "string",
      "enum": [
        "yearly",
        "monthly"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "title",
    "description",
    "plans",
    "billingLabels",
    "periodLabel",
    "featuresLabel"
  ],
  "examples": [
    {
      "title": "Choose a plan that's right for you",
      "description": "Try our basic plan risk free for 30 days. Switch plans or cancel any time.",
      "plans": [
        {
          "name": "Free trial",
          "description": "Best for small teams and freelancers.",
          "monthlyPrice": 0,
          "yearlyPrice": 0,
          "cta": {
            "label": "Start free trial"
          }
        },
        {
          "name": "Business plan",
          "description": "Best for growing teams.",
          "monthlyPrice": 25,
          "yearlyPrice": 20,
          "cta": {
            "label": "Get started"
          },
          "featured": true
        },
        {
          "name": "Enterprise plan",
          "description": "Best for large organizations.",
          "monthlyPrice": 50,
          "yearlyPrice": 40,
          "cta": {
            "label": "Get started"
          }
        }
      ],
      "billingLabels": {
        "yearly": "Annual pricing",
        "monthly": "Monthly pricing"
      },
      "periodLabel": "per month",
      "featuresLabel": "Features",
      "featureGroups": [
        {
          "group": "Basic features",
          "features": [
            {
              "label": "Basic features",
              "tooltip": "Core platform features",
              "values": [
                true,
                true,
                true
              ]
            },
            {
              "label": "Users",
              "tooltip": "Number of team members",
              "values": [
                "10",
                "20",
                "Unlimited"
              ]
            },
            {
              "label": "Individual data",
              "tooltip": "Storage per user",
              "values": [
                "20GB",
                "40GB",
                "Unlimited"
              ]
            },
            {
              "label": "Support",
              "tooltip": "Customer support access",
              "values": [
                true,
                true,
                true
              ]
            },
            {
              "label": "Automated workflows",
              "tooltip": "Workflow automation tools",
              "values": [
                null,
                true,
                true
              ]
            },
            {
              "label": "200+ integrations",
              "tooltip": "Third-party integrations",
              "values": [
                null,
                true,
                true
              ]
            }
          ]
        },
        {
          "group": "Reporting and analytics",
          "features": [
            {
              "label": "Analytics",
              "tooltip": "Data analytics tools",
              "values": [
                "Basic",
                "Advanced",
                "Advanced"
              ]
            },
            {
              "label": "Export reports",
              "tooltip": "Export data to CSV/PDF",
              "values": [
                true,
                true,
                true
              ]
            },
            {
              "label": "Scheduled reports",
              "tooltip": "Automated report delivery",
              "values": [
                true,
                true,
                true
              ]
            },
            {
              "label": "API access",
              "tooltip": "REST API access",
              "values": [
                null,
                true,
                true
              ]
            },
            {
              "label": "Advanced reports",
              "tooltip": "Custom report builder",
              "values": [
                null,
                true,
                true
              ]
            },
            {
              "label": "Saved reports",
              "tooltip": "Save and reuse reports",
              "values": [
                null,
