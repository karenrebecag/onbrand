{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/stepper.schema.json",
  "title": "Stepper",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "error": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "description": "Steps in order. error morphs the marker into an alert and replaces the description."
    },
    "current": {
      "description": "Index of the step in progress. steps.length marks the flow complete.",
      "type": "number"
    },
    "orientation": {
      "description": "Layout direction.",
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ]
    },
    "onStepSelect": {
      "description": "Called with the index of a completed step when chosen. Without it the stepper is read only.",
      "type": "object"
    },
    "details": {
      "description": "\"current\" shows only the active step's description. Errors always show.",
      "type": "string",
      "enum": [
        "all",
        "current"
      ]
    },
    "compact": {
      "description": "Markers only. Horizontal steppers switch to this below 30rem on their own.",
      "type": "boolean"
    },
    "label": {
      "description": "Accessible name for the stepper.",
      "type": "string",
      "format": "tagline"
    },
    "completeLabel": {
      "description": "Announced, and shown in the compact caption, once every step is complete.",
      "type": "string",
      "format": "label"
    }
  },
  "x-formats-version": 2,
  "required": [
    "steps",
    "current"
  ]
}
