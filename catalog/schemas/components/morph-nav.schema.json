{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/morph-nav.schema.json",
  "title": "Morph nav",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "href": {
            "x-undocumented": true,
            "type": "string",
            "format": "link"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "x-undocumented": true
          },
          "columns": {
            "x-undocumented": true,
            "type": "object"
          },
          "feature": {
            "x-undocumented": true
          },
          "footer": {
            "x-undocumented": true
          }
        },
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ]
      },
      "description": "Top level destinations. Items with links or a feature open a panel; other items act as plain links. columns defaults to 2 when there are more than three links. Clicking a link or button inside feature closes the panel."
    },
    "brand": {
      "description": "Brand button at the start of the bar.",
      "type": "object",
      "format": "logo",
      "properties": {
        "name": {
          "x-undocumented": true,
          "type": "string",
          "format": "person"
        },
        "mark": {
          "x-undocumented": true
        },
        "href": {
          "x-undocumented": true,
          "type": "string",
          "format": "link"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "mark"
      ]
    },
    "action": {
      "description": "The one primary action at the end of the bar.",
      "type": "object",
      "properties": {
        "label": {
          "x-undocumented": true,
          "type": "string",
          "format": "tagline"
        },
        "icon": {
          "x-undocumented": true
        },
        "href": {
          "x-undocumented": true,
          "type": "string",
          "format": "link"
        },
        "onClick": {
          "x-undocumented": true,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ]
    },
    "search": {
      "description": "Search entries. Leave it out to hide search.",
      "type": "object"
    },
    "current": {
      "description": "Value of the item that holds the current page.",
      "type": "string"
    },
    "compact": {
      "description": "Tightens the bar, for example once the page scrolls.",
      "type": "boolean"
    },
    "collapseBelow": {
      "description": "Below this container width in px the items fold into one menu.",
      "type": "number"
    },
    "onNavigate": {
      "description": "Called for every destination: links, search results, plain items, and the brand.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name of the nav landmark.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "items"
  ]
}
