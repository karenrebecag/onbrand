{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/password-field.schema.json",
  "title": "Password field",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Visible label tied to the input.",
      "type": "string",
      "format": "tagline"
    },
    "description": {
      "description": "Helper copy under the field, linked through aria-describedby.",
      "type": "string",
      "format": "description"
    },
    "messages": {
      "description": "Names of the reveal toggle, for translation. Pass only the strings you change.",
      "type": "object",
      "properties": {
        "showPassword": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "hidePassword": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        }
      },
      "additionalProperties": false
    }
  },
  "x-formats-version": 2,
  "required": [
    "label"
  ]
}
