{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/slope-chart.schema.json",
  "title": "Slope chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "start": {
            "x-undocumented": true,
            "type": "number"
          },
          "end": {
            "x-undocumented": true,
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "start",
          "end"
        ]
      },
      "description": "Items: { key, label, start, end }. Keys keep lines stable across datasets."
    },
    "label": {
      "description": "What is measured. Names the chart, the summary, and the table.",
      "type": "string",
      "format": "tagline"
    },
    "startLabel": {
      "description": "First column heading, such as \"Q1\".",
      "type": "string",
      "format": "label"
    },
    "endLabel": {
      "description": "Second column heading, such as \"Q2\".",
      "type": "string",
      "format": "label"
    },
    "formatValue": {
      "description": "Formats values beside the points, in the tooltip, and in the table.",
      "type": "object"
    },
    "formatChange": {
      "description": "Formats the change in the tooltip, such as \"+1.5 pts\".",
      "type": "object"
    },
    "height": {
      "description": "Plot height in pixels.",
      "type": "number"
    },
    "highlightKey": {
      "x-nullable": true,
      "description": "The item drawn in the first series hue, derived from the accent.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "activeKey": {
      "x-nullable": true,
      "description": "Controlled item in focus. The others fade.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "onActiveChange": {
      "description": "Called as the item in focus changes.",
      "type": "object"
    },
    "ranks": {
      "description": "Rank movement beside each end value.",
      "type": "boolean"
    },
    "emptyLabel": {
      "description": "Message when there are no items.",
      "type": "string",
      "format": "label"
    },
    "ref": {
      "description": "Forwarded to the figure.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "data",
    "label",
    "startLabel",
    "endLabel"
  ]
}
