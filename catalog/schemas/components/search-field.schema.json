{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/search-field.schema.json",
  "title": "Search field",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Visible label tied to the input.",
      "type": "string",
      "format": "tagline"
    },
    "value": {
      "description": "Current query.",
      "type": "string"
    },
    "onValueChange": {
      "description": "Called on every keystroke and with an empty string when cleared.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "label",
    "value",
    "onValueChange"
  ]
}
