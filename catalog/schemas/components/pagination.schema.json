{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/pagination.schema.json",
  "title": "Pagination",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "description": "Current page, 1-based. Clamped to the range.",
      "type": "number"
    },
    "pageCount": {
      "description": "Total pages. Zero renders an empty nav.",
      "type": "number"
    },
    "onPageChange": {
      "description": "Called with the requested page.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name for the nav landmark.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "page",
    "pageCount",
    "onPageChange"
  ]
}
