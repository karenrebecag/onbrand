{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/color-picker.schema.json",
  "title": "Color picker",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "value": {
      "description": "Controlled color in hex, rgb(), hsl(), or oklch().",
      "type": "string"
    },
    "defaultValue": {
      "description": "Uncontrolled starting color.",
      "type": "string"
    },
    "onValueChange": {
      "description": "Receives the color as uppercase hex, with two alpha digits when it is not opaque.",
      "type": "object"
    },
    "background": {
      "description": "The background the color will sit on, for the WCAG contrast readout.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "label": {
      "description": "Name shown on the swatch, such as \"Accent\".",
      "type": "string",
      "format": "tagline"
    },
    "swatches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "color": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "color"
        ]
      },
      "description": "Controlled saved swatches: { id, color }."
    },
    "defaultSwatches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "color": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "color"
        ]
      },
      "description": "Uncontrolled starting swatches. Defaults to none."
    },
    "onSwatchesChange": {
      "description": "Called when swatches are added, reordered, or removed.",
      "type": "object"
    },
    "maxSwatches": {
      "description": "Most saved swatches. Saving past it drops the oldest.",
      "type": "number"
    },
    "defaultFormat": {
      "description": "Format shown in the text field first.",
      "type": "string",
      "enum": [
        "hex",
        "rgb",
        "hsl",
        "oklch"
      ]
    }
  },
  "x-formats-version": 2
}
