{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/accordion.schema.json",
  "title": "Accordion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          },
          "content": {
            "x-undocumented": true
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ]
      },
      "description": "Rows in order. The title is the trigger label; content fills the panel."
    },
    "defaultOpen": {
      "description": "Index of the row open on first render. Pass -1 to start with every row closed.",
      "type": "number"
    },
    "size": {
      "description": "\"lg\" sets questions at the large text size for page-level FAQs.",
      "type": "string",
      "enum": [
        "md",
        "lg"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "items"
  ]
}
