{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/activity-heatmap.schema.json",
  "title": "Activity heatmap",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "x-undocumented": true,
            "type": "string",
            "format": "date"
          },
          "count": {
            "x-undocumented": true,
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "date",
          "count"
        ]
      },
      "description": "One entry per day as YYYY-MM-DD, oldest first. Missing days count as zero."
    },
    "label": {
      "description": "Accessible name for the grid, such as \"Contributions in 2025\".",
      "type": "string",
      "format": "tagline"
    },
    "period": {
      "description": "Finishes the summary: \"1,284 contributions in {period}\".",
      "type": "string"
    },
    "unit": {
      "description": "Nouns for the count.",
      "type": "object"
    },
    "thresholds": {
      "description": "Upper bounds for levels one to three. Defaults to quarters of the busiest day.",
      "type": "object"
    },
    "weekStartsOn": {
      "description": "Sunday or Monday as the first row.",
      "type": "object"
    },
    "selectedDate": {
      "x-nullable": true,
      "description": "Day drawn with a selection ring.",
      "type": "string",
      "format": "date"
    },
    "onSelectDate": {
      "description": "Called on click, Enter, or Space.",
      "type": "object"
    },
    "actions": {
      "description": "Controls beside the summary, such as a range switch."
    },
    "locale": {
      "description": "Formatting locale.",
      "type": "string"
    }
  },
  "x-formats-version": 2,
  "required": [
    "days",
    "label",
    "period"
  ]
}
