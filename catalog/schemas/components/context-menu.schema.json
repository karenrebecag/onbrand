{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/context-menu.schema.json",
  "title": "Context menu",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "children": {
      "description": "The target area."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "icon": {
            "x-undocumented": true
          },
          "onSelect": {
            "x-undocumented": true,
            "type": "object"
          },
          "disabled": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "destructive": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "checked": {
            "x-undocumented": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "description": "Items: { id, label, icon?, onSelect?, disabled?, destructive?, checked? }."
    },
    "label": {
      "description": "Accessible name for both the target and the menu.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "children",
    "items"
  ]
}
