{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/breadcrumb.schema.json",
  "title": "Breadcrumb",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "href": {
            "x-undocumented": true,
            "type": "string",
            "format": "link"
          },
          "onClick": {
            "x-undocumented": true,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "description": "Path from root to current page. Items with href render a plain a, or the link component set with UikitProvider (such as next/link or a locale-aware Link); items with only onClick render buttons."
    },
    "ariaLabel": {
      "description": "Label for the nav landmark.",
      "type": "string",
      "format": "label"
    }
  },
  "x-formats-version": 2,
  "required": [
    "items"
  ]
}
