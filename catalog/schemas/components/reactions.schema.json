{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/reactions.schema.json",
  "title": "Reactions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "icon": {
            "x-undocumented": true,
            "type": "object",
            "format": "icon"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "icon"
        ]
      },
      "description": "Every reaction the picker offers: { id, label, icon: LucideIcon }."
    },
    "value": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "count": {
            "x-undocumented": true,
            "type": "number"
          },
          "reacted": {
            "x-undocumented": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "reacted"
        ]
      },
      "description": "Controlled reactions: { id, count, reacted }. Pills keep this order; a count of zero leaves the bar."
    },
    "defaultValue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "count": {
            "x-undocumented": true,
            "type": "number"
          },
          "reacted": {
            "x-undocumented": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "reacted"
        ]
      },
      "description": "Initial reactions when uncontrolled."
    },
    "onValueChange": {
      "description": "Called with the next list and the change that produced it.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name for the bar.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "options"
  ]
}
