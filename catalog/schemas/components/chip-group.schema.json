{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/chip-group.schema.json",
  "title": "Chip group",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          }
        },
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ]
      },
      "description": "Chips in order."
    },
    "value": {
      "description": "Selected values.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onValueChange": {
      "description": "Called with the new selection, in option order.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name of the group, such as \"Topics\".",
      "type": "string",
      "format": "tagline"
    },
    "multiple": {
      "description": "Allow several chips. In single mode the selected chip can still be cleared.",
      "type": "boolean"
    },
    "maxVisible": {
      "description": "Chips shown before the rest fold. Selected chips always stay in view.",
      "type": "number"
    }
  },
  "x-formats-version": 2,
  "required": [
    "options",
    "value",
    "onValueChange",
    "label"
  ]
}
