{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/radio-group.schema.json",
  "title": "Radio group",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Rendered as the fieldset legend.",
      "type": "string",
      "format": "tagline"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Rows in order, each with optional secondary copy."
    },
    "value": {
      "description": "Selected value.",
      "type": "string"
    },
    "onValueChange": {
      "description": "Called with the chosen value.",
      "type": "object"
    },
    "name": {
      "description": "Native radio name for form submission. Generated when omitted.",
      "type": "string",
      "format": "person"
    }
  },
  "x-formats-version": 2,
  "required": [
    "label",
    "options",
    "value",
    "onValueChange"
  ]
}
