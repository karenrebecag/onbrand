{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/control-center.schema.json",
  "title": "Control center",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "focusModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "icon": {
            "x-undocumented": true,
            "type": "object",
            "format": "icon"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "defaultMinutes": {
            "x-undocumented": true,
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "icon",
          "description",
          "defaultMinutes"
        ]
      },
      "description": "Focus modes offered in the focus detail. defaultMinutes seeds the session dial."
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "defaultOn": {
            "x-undocumented": true,
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "description": "Notification channels toggled in the notifications detail."
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "avatar": {
            "x-undocumented": true,
            "type": "string",
            "format": "image"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "avatar"
        ]
      },
      "description": "People who can still reach you during a focus session."
    },
    "defaultVolume": {
      "description": "Initial alert volume, 0 to 100.",
      "type": "number"
    },
    "defaultTextSize": {
      "description": "Initial text size as a percent of the base, 85 to 130.",
      "type": "number"
    },
    "formatTime": {
      "description": "Formats the end of a session. Defaults to a short en-US clock time.",
      "type": "object"
    },
    "onStateChange": {
      "description": "Called with the full settings state after any change, including each step while a meter is dragged. Focus detail edits apply only on Start or Update session.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name of the panel.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "focusModes",
    "channels"
  ]
}
