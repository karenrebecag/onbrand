{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/select.schema.json",
  "title": "Select",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Visible label for the trigger.",
      "type": "string",
      "format": "tagline"
    },
    "description": {
      "description": "Helper copy under the trigger, linked through aria-describedby.",
      "type": "string",
      "format": "description"
    },
    "placeholder": {
      "description": "Shown when no value is selected.",
      "type": "string",
      "format": "label"
    },
    "id": {
      "description": "Trigger id. Generated when omitted.",
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Items in list order."
    }
  },
  "x-formats-version": 2,
  "required": [
    "label",
    "options"
  ]
}
