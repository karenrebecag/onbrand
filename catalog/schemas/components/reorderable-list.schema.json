{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/reorderable-list.schema.json",
  "title": "Reorderable list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "title": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          },
          "detail": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "title"
        ]
      },
      "description": "Items in their current order."
    },
    "onReorder": {
      "description": "Called with the new order on drag or keyboard move.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name for the list.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "items",
    "onReorder"
  ]
}
