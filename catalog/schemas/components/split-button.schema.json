{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/split-button.schema.json",
  "title": "Split button",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Main action label. Changes morph letter by letter.",
      "type": "string",
      "format": "tagline"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "onSelect": {
            "x-undocumented": true,
            "type": "object"
          },
          "disabled": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "destructive": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "icon": {
            "x-undocumented": true
          }
        },
        "additionalProperties": false,
        "required": [
          "label"
        ]
      },
      "description": "Menu items: { label, onSelect?, disabled?, destructive?, icon? }."
    },
    "onClick": {
      "description": "Runs the main action.",
      "type": "object"
    },
    "disabled": {
      "description": "Disables both the main action and the menu trigger.",
      "type": "boolean"
    },
    "icon": {
      "description": "Leading icon on the main half. A different icon element crossfades in."
    },
    "variant": {
      "description": "Visual weight of both halves.",
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ]
    }
  },
  "x-formats-version": 2,
  "required": [
    "label",
    "actions"
  ],
  "x-variants": [
    "primary",
    "secondary"
  ]
}
