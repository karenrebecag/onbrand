{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/action-morph.schema.json",
  "title": "Action morph",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "icon": {
            "x-undocumented": true
          },
          "shortcut": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "composer": {
            "x-undocumented": true,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "icon",
          "composer"
        ]
      },
      "description": "Actions: { id, label, description?, icon, shortcut?, composer }. composer is { title, placeholder, multiline?, choices?, submitLabel, successLabel, emptyHint? }."
    },
    "label": {
      "description": "Accessible name of the button and the title of the menu.",
      "type": "string",
      "format": "tagline"
    },
    "onSubmit": {
      "description": "Receives { action, text, choice? }. Return a promise to hold the sending state; a rejection keeps the composer open with the draft and an error.",
      "type": "object"
    },
    "corner": {
      "description": "Which bottom corner the button sits in. The surface grows away from it.",
      "type": "string",
      "enum": [
        "end",
        "start"
      ]
    },
    "resetAfter": {
      "description": "Milliseconds the check stays before the button returns to its plus.",
      "type": "number"
    }
  },
  "x-formats-version": 2,
  "required": [
    "actions"
  ]
}
