{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/avatar-group.schema.json",
  "title": "Avatar group",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "src": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "status": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "online",
              "offline"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "description": "People in display order. Names double as keys, so keep them unique."
    },
    "max": {
      "description": "Avatars shown before the rest collapse into the overflow count.",
      "type": "number"
    },
    "size": {
      "description": "Size passed to each avatar and the overflow chip.",
      "type": "string",
      "enum": [
        "sm",
        "md",
        "lg"
      ]
    },
    "label": {
      "description": "Accessible name for the group, also used in the overflow label.",
      "type": "string",
      "format": "tagline"
    }
  },
  "x-formats-version": 2,
  "required": [
    "members"
  ]
}
