{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/components/orbit-menu.schema.json",
  "title": "Orbit menu",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "icon": {
            "x-undocumented": true
          },
          "done": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "tone": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "neutral",
              "danger"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "icon"
        ]
      },
      "description": "Three to six actions. done is the short confirmation shown after firing and defaults to the label."
    },
    "onAction": {
      "description": "Called with the fired action's id.",
      "type": "object"
    },
    "label": {
      "description": "Accessible name of the button and menu, also shown while the arc is open and nothing is targeted.",
      "type": "string",
      "format": "tagline"
    },
    "radius": {
      "description": "Distance from the button center to each action, in px.",
      "type": "number"
    },
    "spread": {
      "description": "Degrees the arc spans.",
      "type": "number"
    },
    "direction": {
      "description": "Degrees the arc opens toward: -90 up, 0 right, 90 down, 180 left.",
      "type": "number"
    },
    "disabled": {
      "description": "Disables the trigger and closes the arc.",
      "type": "boolean"
    },
    "announce": {
      "description": "Announces confirmations in a polite status region.",
      "type": "boolean"
    },
    "onOpenChange": {
      "description": "Called when the arc opens or closes.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "actions",
    "onAction"
  ]
}
