{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-bento-grid.schema.json",
  "title": "Bento Grid React Component for SaaS UI",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Titular de la sección sobre la grilla; sin él no hay cabecera.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Texto de apoyo bajo el titular.",
      "type": "string",
      "format": "description"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Celdas del grid; sin ellas se muestra la demo completa.",
      "maxItems": 7
    }
  },
  "x-formats-version": 2,
  "examples": [
    {
      "items": [
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ]
    }
  ]
}
