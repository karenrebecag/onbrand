{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/product-detail.schema.json",
  "title": "Product detail",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "product": {
      "description": "The product with finishes, sizes, reviews, shipping lines, and detail sections.",
      "type": "object",
      "properties": {
        "id": {
          "x-undocumented": true,
          "type": "string"
        },
        "name": {
          "x-undocumented": true,
          "type": "string",
          "format": "person"
        },
        "collection": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "summary": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "finishes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          },
          "x-undocumented": true
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          },
          "x-undocumented": true
        },
        "rating": {
          "x-undocumented": true,
          "type": "number"
        },
        "reviewCount": {
          "x-undocumented": true,
          "type": "number"
        },
        "distribution": {
          "x-undocumented": true,
          "type": "object"
        },
        "shipping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          },
          "x-undocumented": true
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          },
          "x-undocumented": true
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "collection",
        "summary",
        "finishes",
        "sizes",
        "rating",
        "reviewCount",
        "distribution",
        "shipping",
        "sections"
      ]
    },
    "defaultFinish": {
      "description": "Initial finish id.",
      "type": "string"
    },
    "defaultSize": {
      "description": "Initial size id.",
      "type": "string"
    },
    "onAddToCart": {
      "description": "Adds the selection. Return a promise to show Adding until it settles; a rejection shows Try again. Without it the preview simulates a short request.",
      "type": "object"
    },
    "onNotify": {
      "description": "Called when someone asks to be told when a sold out finish and size is back.",
      "type": "object"
    },
    "onWishlistChange": {
      "description": "Called when the heart is toggled.",
      "type": "object"
    },
    "defaultCartCount": {
      "description": "Items already in the bag.",
      "type": "number"
    },
    "maxQuantity": {
      "description": "Upper bound of the stepper.",
      "type": "number"
    },
    "currency": {
      "x-undocumented": true,
      "type": "string"
    },
    "locale": {
      "x-undocumented": true,
      "type": "string"
    }
  },
  "x-formats-version": 2,
  "required": [
    "product"
  ]
}
