{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-feature-cards.schema.json",
  "title": "Animated Feature Cards for React Tailwind Framer Motion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Titular de la sección sobre la grilla; sin él no hay cabecera.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Texto de apoyo bajo el titular.",
      "type": "string",
      "format": "description"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Tarjetas del grid; sin ellas se muestra la demo completa.",
      "maxItems": 3
    }
  },
  "x-formats-version": 2,
  "examples": [
    {
      "cards": [
        {
          "name": "Customer Care",
          "subtitle": "Account help",
          "icon": "user"
        },
        {
          "name": "Sales Team",
          "subtitle": "Product questions",
          "icon": "question"
        },
        {
          "name": "Support Team",
          "subtitle": "Billing inquiries",
          "icon": "receipt"
        }
      ]
    }
  ]
}
