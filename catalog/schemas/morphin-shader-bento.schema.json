{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-shader-bento.schema.json",
  "title": "React Bento Grid for SaaS Dashboards",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          },
          "description": {
            "x-undocumented": true,
            "type": "string",
            "format": "description"
          },
          "fade": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "top",
              "bottom"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ]
      },
      "description": "Tarjetas del grid; sin ellas se muestra la demo completa."
    },
    "colors": {
      "description": "Tres colores del shader (el canvas no lee variables CSS, van como literales).",
      "type": "array",
      "items": {
        "type": "string",
        "x-format-confidence": "low"
      },
      "maxItems": 3
    }
  },
  "x-formats-version": 2,
  "required": [
    "colors"
  ],
  "examples": [
    {
      "colors": [
        "#085b96",
        "#51a0f6",
        "#cfe5f2"
      ]
    }
  ]
}
