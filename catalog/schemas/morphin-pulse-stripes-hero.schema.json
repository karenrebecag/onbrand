{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-pulse-stripes-hero.schema.json",
  "title": "Beautiful layout page with pulse stripes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Headline.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "Supporting text under the headline.",
      "type": "string",
      "format": "description"
    },
    "primaryAction": {
      "type": "object",
      "format": "cta",
      "properties": {
        "label": {
          "x-undocumented": true,
          "type": "string",
          "format": "tagline"
        },
        "href": {
          "x-undocumented": true,
          "type": "string",
          "format": "link"
        },
        "variant": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "ghost",
            "danger",
            "whatsapp"
          ]
        },
        "cta": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "agendar_demo",
            "hablar_asesor",
            "demo_5min",
            "consultar_precio"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ]
    },
    "secondaryAction": {
      "type": "object",
      "format": "cta",
      "properties": {
        "label": {
          "x-undocumented": true,
          "type": "string",
          "format": "tagline"
        },
        "href": {
          "x-undocumented": true,
          "type": "string",
          "format": "link"
        },
        "variant": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "ghost",
            "danger",
            "whatsapp"
          ]
        },
        "cta": {
          "x-undocumented": true,
          "type": "string",
          "enum": [
            "agendar_demo",
            "hablar_asesor",
            "demo_5min",
            "consultar_precio"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ]
    },
    "stats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Numbers shown under the actions. Pass an empty array to hide the row."
    },
    "logos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Logos for the marquee under the hero. Pass an empty array to hide it."
    }
  },
  "x-formats-version": 2
}
