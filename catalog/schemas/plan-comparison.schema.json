          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "monthly": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "yearly": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "monthlyNote": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
        },
        "yearlyNote": {
          "x-undocumented": true,
          "type": "string",
          "x-format-confidence": "low"
