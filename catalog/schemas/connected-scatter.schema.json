{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/connected-scatter.schema.json",
  "title": "Connected scatter",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "x-undocumented": true
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            },
            "x-undocumented": true
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "points"
        ]
      },
      "description": "Series to switch between: id, name, points in time order ({ label, x, y }) and optional notes ({ index, text, side }) that label key months. Every series needs the same number of points so the path can morph.",
      "maxItems": 3,
      "x-empty": "omit"
    },
    "defaultSeries": {
      "description": "Id of the series shown first. Defaults to the first series.",
      "type": "string"
    },
    "xAxis": {
      "description": "Horizontal axis: short name for the readout, title printed on the axis, min, max and gridline step. The sample is CAC from $200 to $1,800.",
      "type": "object",
      "properties": {
        "name": {
          "x-undocumented": true,
          "type": "string",
          "format": "person"
        },
        "title": {
          "x-undocumented": true,
          "type": "string",
          "format": "heading"
        },
        "min": {
          "x-undocumented": true,
          "type": "number"
        },
        "max": {
          "x-undocumented": true,
          "type": "number"
        },
        "step": {
          "x-undocumented": true,
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "min",
        "max",
        "step"
      ],
      "x-empty": "omit"
    },
    "yAxis": {
      "description": "Vertical axis, same shape. The sample is 12 month LTV from $2,000 to $6,000.",
      "type": "object",
      "properties": {
        "name": {
          "x-undocumented": true,
          "type": "string",
          "format": "person"
        },
        "title": {
          "x-undocumented": true,
          "type": "string",
          "format": "heading"
        },
        "min": {
          "x-undocumented": true,
          "type": "number"
        },
        "max": {
          "x-undocumented": true,
          "type": "number"
        },
        "step": {
          "x-undocumented": true,
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "min",
        "max",
        "step"
      ],
      "x-empty": "omit"
    },
    "targetRatio": {
      "description": "Slope of the reference line y = targetRatio times x. The region above it is shaded as healthy and the readout says whether the selected month is above or below it.",
      "type": "number"
    },
    "formatValue": {
      "description": "Formats values in the readout, the tooltip, the axis ticks and the screen reader table.",
      "type": "object"
    },
    "title": {
      "description": "Block heading.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "One line under the heading. Defaults to a sentence naming the metrics and the date range.",
      "type": "string",
      "format": "description"
    },
    "onMonthChange": {
      "description": "Called with the month index whenever the head settles on a month: a released scrub, a key press, a tap on a point, or the end of playback. Not called on every frame.",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "series",
    "xAxis",
    "yAxis",
    "targetRatio"
  ],
