{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/line-replay.schema.json",
  "title": "Line replay",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Heading of the block.",
      "type": "string",
      "format": "heading"
    },
    "description": {
      "description": "One line under the heading that names what is measured and when.",
      "type": "string",
      "format": "description"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "x-undocumented": true,
            "type": "number"
          },
          "value": {
            "x-undocumented": true,
            "type": "number"
          },
          "baseline": {
            "x-undocumented": true,
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "time",
          "value"
        ]
      },
      "description": "Points in time order: `time` in minutes from the start, the replayed `value`, and an optional `baseline` drawn in full as a quiet dashed comparison. Leave `baseline` out of every point to hide the comparison, its legend entry and the ratio readout.",
      "maxItems": 288,
      "x-empty": "omit"
    },
    "moments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "time": {
            "x-undocumented": true,
            "type": "number"
          },
          "title": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          },
          "detail": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "kind": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "launch",
              "press",
              "email",
              "incident",
              "milestone"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "time",
          "title"
        ]
      },
      "description": "Key moments on the same clock: `id`, `time`, `title`, an optional one-line `detail` and a `kind` (launch, press, email, incident or milestone) that picks the icon. Incidents are drawn in the warning color and their effect is the dip over 20 minutes; every other moment reports the rise over the next hour.",
      "maxItems": 6,
      "x-empty": "omit"
    },
    "seriesLabel": {
      "description": "Legend name of the replayed line.",
      "type": "string",
      "format": "label",
      "x-empty": "omit"
    },
    "baselineLabel": {
      "description": "Legend name of the comparison line, also used in the ratio readout (\"Versus typical Tuesday\").",
      "type": "string",
      "format": "label",
      "x-empty": "omit"
    },
    "valueLabel": {
      "description": "Label of the value under the playhead, in the readout and the scrubber's value text.",
      "type": "string",
      "format": "label",
      "x-empty": "omit"
    },
    "formatTime": {
      "description": "Formats a time on the replay clock for the readout, the playhead clock, callouts and the moments list. The default prints 9:40 am.",
      "type": "object"
    },
    "formatTick": {
      "description": "Formats the time axis labels. The default prints 6 am.",
      "type": "object"
    },
    "formatValue": {
      "description": "Formats values in the readout, the tip label and moment effects.",
      "type": "object"
    },
    "duration": {
      "description": "Seconds a full replay takes at 1×.",
      "type": "number"
    },
    "defaultSpeed": {
      "description": "Starting playback speed.",
      "type": "object"
    },
    "defaultPosition": {
      "description": "Where the playhead rests before the first play. \"end\" shows the whole line with every moment; pressing Replay rewinds and plays from the start.",
      "type": "string",
      "enum": [
        "start",
        "end"
      ]
    },
    "autoPlay": {
      "description": "Plays from the start the first time the block is 40% in view. Ignored with reduced motion.",
      "type": "boolean"
    },
    "onMomentReached": {
      "description": "Called when playback passes a moment (not when scrubbing or jumping).",
      "type": "object"
    }
  },
  "x-formats-version": 2,
  "required": [
    "data",
    "moments"
  ],
