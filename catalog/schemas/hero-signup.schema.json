{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/hero-signup.schema.json",
  "title": "Hero Signup",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Headline. A string rises in word by word on load."
    },
    "description": {
      "description": "One supporting line under the headline."
    },
    "placeholder": {
      "description": "Email field placeholder.",
      "type": "string",
      "format": "label"
    },
    "buttonLabel": {
      "description": "Submit label.",
      "type": "string",
      "format": "cta"
    },
    "shortButtonLabel": {
      "description": "Submit label on very narrow layouts.",
      "type": "string",
      "format": "cta"
    },
    "footnote": {
      "description": "Quiet line under the field. Validation, a typo fix, a failure with retry, and the confirmation replace it in place."
    },
    "count": {
      "description": "People already on the list. Omit it to hide the social proof. The count rolls up by one when the visitor joins.",
      "type": "number"
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      },
      "description": "Portraits in the social proof stack. Up to five are shown.",
      "x-empty": []
    },
    "labels": {
