{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/morphin-page-fold-menu.schema.json",
  "title": "GSAP Page Fold Navigation Menu",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "x-undocumented": true,
            "type": "string",
            "format": "tagline"
          },
          "href": {
            "x-undocumented": true,
            "type": "string",
            "format": "link"
          }
        },
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ]
      },
      "description": "Enlaces del menu a pantalla completa.",
      "maxItems": 4
    },
    "brandName": {
      "description": "Texto de marca en el header.",
      "type": "string",
      "x-format-confidence": "low"
    },
    "logo": {
      "description": "Logo propio; se pinta antes de `brandName`."
    },
    "brandHref": {
      "type": "string",
      "x-format-confidence": "low"
    },
    "menuLabel": {
      "description": "Texto del boton cerrado.",
      "type": "string",
      "format": "label"
    },
    "closeLabel": {
      "description": "Texto del boton abierto.",
      "type": "string",
      "format": "label"
    },
    "navAriaLabel": {
      "description": "Nombre accesible del `<nav>`.",
      "type": "string",
      "format": "label"
    },
    "position": {
      "description": "`fixed` flota sobre la pagina; `sticky` y `static` ocupan su altura en flujo para no tapar la primera seccion.",
      "type": "string",
      "enum": [
        "fixed",
        "sticky",
        "static"
      ]
    },
    "children": {
      "description": "La pagina que se pliega al abrir el menu."
    }
  },
  "x-formats-version": 2,
  "required": [
    "items"
  ],
  "examples": [
    {
      "items": [
        {
          "label": "Home",
          "href": "#"
        },
        {
          "label": "Components",
          "href": "#"
        },
        {
          "label": "Inspirations",
          "href": "#"
        },
        {
          "label": "GitHub",
          "href": "#"
        }
      ]
    }
  ]
}
