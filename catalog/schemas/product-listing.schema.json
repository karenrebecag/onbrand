{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/product-listing.schema.json",
  "title": "Product listing",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "detail": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "price": {
            "x-undocumented": true,
            "type": "number",
            "x-format-confidence": "low"
          },
          "compareAt": {
            "x-undocumented": true,
            "type": "number"
          },
          "image": {
            "x-undocumented": true,
            "type": "string",
            "format": "image"
          },
          "hoverImage": {
            "x-undocumented": true,
            "type": "string",
            "format": "image"
          },
          "alt": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "colors": {
            "x-undocumented": true,
            "type": "array",
            "items": {
              "type": "string",
              "x-format-confidence": "low"
            }
          },
          "sizes": {
            "x-undocumented": true,
            "type": "array",
            "items": {
              "type": "string",
              "x-format-confidence": "low"
            }
          },
          "inStock": {
            "x-undocumented": true,
            "type": "boolean"
          },
          "badge": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          },
          "added": {
            "x-undocumented": true,
            "type": "number"
          },
          "rank": {
            "x-undocumented": true,
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "detail",
          "price",
          "image",
          "alt",
          "colors",
          "sizes",
          "inStock",
          "added",
          "rank"
        ]
      },
      "description": "Products to list. The price range bounds come from these prices, rounded to 10."
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "x-undocumented": true,
            "type": "string"
          },
          "name": {
            "x-undocumented": true,
            "type": "string",
            "format": "person"
          },
          "swatch": {
            "x-undocumented": true,
            "type": "string",
            "x-format-confidence": "low"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "swatch"
        ]
      },
      "description": "{ id, name, swatch } for the color filter and the dots under each card."
    },
    "sizes": {
      "description": "Size filter options.",
      "type": "array",
      "items": {
        "type": "string",
        "x-format-confidence": "low"
      }
    },
    "defaultSort": {
      "description": "Initial sort. Featured uses rank, newest uses added.",
      "type": "string",
      "enum": [
        "featured",
        "price-asc",
        "price-desc",
        "newest"
      ]
    },
    "onAddToCart": {
      "description": "Called when a product is added from its card. Single size products add straight away.",
      "type": "object"
    },
    "defaultCartCount": {
      "description": "Items already in the bag.",
      "type": "number"
    },
    "currency": {
      "description": "ISO currency for prices.",
      "type": "string"
    },
    "locale": {
      "description": "Locale for price formatting.",
      "type": "string"
    },
    "title": {
      "description": "Collection heading.",
      "type": "string",
      "format": "heading"
    }
  },
  "x-formats-version": 2,
  "required": [
    "products",
    "colors",
    "sizes"
  ]
}
