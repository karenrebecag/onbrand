{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arc/cta13_block.schema.json",
  "title": "CTA 13",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "type": "string",
      "format": "heading"
    },
    "description": {
      "type": "string",
      "format": "description"
    },
    "buttons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "ghost",
              "danger",
              "whatsapp"
            ]
          },
          "size": {
            "x-undocumented": true,
            "type": "string",
            "enum": [
              "sm",
              "md",
              "lg"
            ]
          },
          "href": {
            "x-undocumented": true,
            "type": "string",
            "format": "link"
          },
          "title": {
            "x-undocumented": true,
            "type": "string",
            "format": "heading"
          }
        },
        "additionalProperties": false,
        "required": [
          "title"
        ]
      }
    }
  },
  "x-formats-version": 2,
  "required": [
    "heading",
    "description",
    "buttons"
  ]
}
